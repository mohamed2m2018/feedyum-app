{
  "expo": {
    "name": "FeedYum",
    "slug": "feedyum",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/98042cba-f7a5-408c-851b-15482b2769d6",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 5000
    },
    "scheme": "feedyum",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF4D67"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.feedyum.app",
      "googleServicesFile": "./ios/GoogleService-Info.plist",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "FeedYum needs your location to show nearby restaurants",
        "NSCameraUsageDescription": "FeedYum needs camera access for taking photos and videos",
        "NSPhotoLibraryUsageDescription": "FeedYum needs access to your photos to upload images",
        "NSPhotoLibraryAddUsageDescription": "FeedYum needs access to save photos to your library",
        "NSMicrophoneUsageDescription": "FeedYum needs microphone access for recording videos",
        "LSApplicationQueriesSchemes": [
          "instagram",
          "instagram-stories",
          "whatsapp",
          "twitter",
          "fb"
        ]
      },
      "config": {
        "googleMapsApiKey": "***REMOVED***"
      }
    },
    "android": {
      "package": "com.feedyum",
      "googleServicesFile": "./google-services.json",
      "versionCode": 9,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF4D67"
      },
      "config": {
        "googleMaps": {
          "apiKey": "***REMOVED***"
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "feedyum.com",
              "pathPrefix": "/"
            },
            {
              "scheme": "http",
              "host": "feedyum.com",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "queries": {
        "schemes": [
          "instagram",
          "instagram-stories",
          "whatsapp",
          "twitter",
          "fb"
        ]
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "15.1"
          },
          "android": {
            "kotlinVersion": "1.9.23",
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "extraProguardRules": "-keep class ** { *; }"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location."
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      [
        "react-native-permissions",
        {
          "iosPermissions": [
            "Camera",
            "PhotoLibrary",
            "LocationWhenInUse",
            "Notifications",
            "Microphone"
          ]
        }
      ],
      "expo-web-browser",
      "./plugins/withOrderAlarmChannel"
    ],
    "extra": {
      "eas": {
        "projectId": "98042cba-f7a5-408c-851b-15482b2769d6"
      }
    },
    "owner": "mohamed2m2035"
  }
}